# === DevNotes · variables de entorno ===
# Copia este archivo a ".env" y rellena con TUS valores.
# NUNCA subas el archivo .env real al repositorio.

# --- Supabase (Semana 1) ---
# Las encuentras en: panel de Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- AWS (Semana 3) ---
# Se añadirán en las sesiones 5 y 6 (S3 + CloudFront, Rekognition).
# VITE_AWS_REGION=eu-west-1
# VITE_S3_BUCKET=devnotes-tu-nombre
# VITE_CLOUDFRONT_URL=https://xxxxxxxx.cloudfront.net
